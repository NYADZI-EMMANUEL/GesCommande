@{
    ViewData["Title"] = "Panier";
    var panier = ViewBag.Panier as List<BrasilburgerC.Models.PanierItem>;
    var complements = ViewBag.Complements as List<BrasilburgerC.Models.Complement>;
    var zones = ViewBag.Zones as List<BrasilburgerC.Models.Zone>;
    var total = ViewBag.Total;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    <div class="d-flex" style="gap:5%;">
        <!-- Sidebar -->
        <div class="bg-warning text-white" style="height: 100%; width: 15%; position: fixed; top: 0; left: 0;padding-left:10px; padding-top:10px;padding-bottom:10px;padding-right:0;background: linear-gradient(180deg, #FFA629 0%, #000000 100%);">
            <div class="text-center mb-4">
                <img src="https://res.cloudinary.com/dx2imkeka/image/upload/v1766200802/logo_brasil_burger_1_atsto9.png" alt="Logo" class="rounded-circle mb-3">
            </div>
            
            <nav class="nav flex-column">
                <a class="nav-link text-white mb-2" asp-controller="Catalogue" asp-action="Index" style="border-radius: 20px 0 0 20px; padding-left:10px; padding-top:10px; padding-bottom:10px; padding-right:0;">
                    <span><i class="bi bi-newspaper text-white"></i></span> Catalogue
                </a>
                <a class="nav-link text-white bg-dark mb-2 p-3" asp-controller="Panier" asp-action="Index" style="border-radius: 20px 0 0 20px; padding-left:10px; padding-top:10px; padding-bottom:10px; padding-right:0;">
                    <span><i class="bi bi-bag-fill text-white"></i></span> Panier
                </a>
                <a class="nav-link text-white p-3" asp-controller="Commande" asp-action="Index">
                    <span><i class="bi bi-clipboard-fill text-white"></i></span> Commades
                </a>
                <a class="nav-link text-white p-3" href="#">
                    <span><i class="bi bi-person-fill text-white"></i></span> @ViewBag.UserPrenom @ViewBag.UserNom
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="flex-grow-1 p-4" style="width: 80%; margin-left:17%; margin-top:20px;">
            <h2 class="mb-4">Panier</h2>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form method="post" asp-action="Valider">
                        <!-- Liste des produits -->
                        @foreach (var item in panier ?? new List<BrasilburgerC.Models.PanierItem>())
                        {
                            <div class="row mb-3">
                                <div class="col-md-2">
                                    <img src="@item.Image" alt="@item.Nom" class="img-fluid rounded" style="height: 80px; object-fit: cover;">
                                </div>
                                <div class="col-md-7">
                                    <h6 class="fw-bold mb-0">@item.Nom</h6>
                                    <p class="text-warning fw-bold mb-0">@item.Prix fcfa</p>
                                </div>
                                <div class="col-md-3 text-end">
                                    <span class="btn btn-sm btn-danger" style="width: 30px; height: 30px; border-radius: 50%; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                                        <i class="bi bi-trash"></i>
                                    </span>
                                    <div class="input-group input-group-sm mt-2" style="width: 100px; float: right;">
                                        <button type="button" class="btn btn-outline-secondary">-</button>
                                        <input type="text" class="form-control text-center" value="@item.Quantite" readonly>
                                        <button type="button" class="btn btn-outline-secondary">+</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Dropdown pour ajouter des compléments -->
                            @if (item.Type == "Burger" || item.Type == "Menu")
                            {
                                <div class="row mb-3">
                                    <div class="col-md-12">
                                        <select class="form-select" style="border-radius: 10px;">
                                            <option selected disabled>Choisir complement</option>
                                            @foreach (var comp in complements ?? new List<BrasilburgerC.Models.Complement>())
                                            {
                                                <option value="@comp.Id">@comp.Nom - @comp.Prix fcfa</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }

                            <hr />
                        }

                        <div class="row mt-4">
                            <!-- Mode de réception -->
                            <div class="col-md-6">
                                <h5 class="mb-3">Mode de reception</h5>
                                
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="mode" value="Sur_place" id="surPlace">
                                    <label class="form-check-label" for="surPlace">sur place</label>
                                </div>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="mode" value="Emporter" id="emporter">
                                    <label class="form-check-label" for="emporter">emporter</label>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="mode" value="Livraison" id="livraison">
                                    <label class="form-check-label" for="livraison">Livraison</label>
                                </div>

                                <select class="form-select mb-3" name="zoneId" style="border-radius: 10px;">
                                    <option selected disabled>Livraison, choisir la zone</option>
                                    @foreach (var zone in zones ?? new List<BrasilburgerC.Models.Zone>())
                                    {
                                        <option value="@zone.Id">@zone.Nom - @zone.Prix fcfa</option>
                                    }
                                </select>

                                <input type="text" class="form-control" name="adresse" placeholder="Entrer le quartier ou votre table" style="border-radius: 10px;">
                            </div>

                            <!-- Paiement -->
                            <div class="col-md-6">
                                <h5 class="mb-3">Paiement</h5>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="typePaiement" value="Wave" id="wave">
                                    <label class="form-check-label d-flex align-items-center" for="wave">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/72/Wave_mobile_money_logo.png/200px-Wave_mobile_money_logo.png" alt="Wave" style="height: 40px; margin-left: 10px;">
                                    </label>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio" name="typePaiement" value="OM" id="om">
                                    <label class="form-check-label d-flex align-items-center" for="om">
                                        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/Orange_Money_Logo.svg/200px-Orange_Money_Logo.svg.png" alt="Orange Money" style="height: 40px; margin-left: 10px;">
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Total et bouton Commander -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <h4>Total : <span class="text-warning fw-bold">@total fcfa</span></h4>
                            </div>
                            <div class="col-md-6 text-end">
                                <button type="submit" class="btn btn-lg text-white px-5" style="background: linear-gradient(90deg, #FFA629 0%, #8B4513 100%); border-radius: 30px;">
                                    Commander
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>